{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_API_MOCKING=enabled expo start --clear",
    "dev": "pnpm install && REACT_NATIVE_DISABLE_DEVTOOLS=1 EXPO_NO_DEV_TOOLS=1  EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --port $PORT --dev-client",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "dev:build": "node scripts/dev.js",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --clean",
    "android:build": "expo run:android --no-launch",
    "android:mock": "EXPO_PUBLIC_API_MOCKING=enabled expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check:release-bundle": "sh scripts/check-release-bundle.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "easbuild": "eas build --platform android --profile development --local",
    "db:generate": "drizzle-kit generate",
    "db:bench": "jest --testMatch '**/db/bench/*.bench.ts' --runInBand"
  },

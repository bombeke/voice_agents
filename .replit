modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Start application"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install && cd artifacts/mobile && BROWSER=none REACT_NATIVE_DISABLE_DEVTOOLS=1 EXPO_NO_DEV_TOOLS=1 pnpm exec expo start --web --port 4999 --host localhost & PORT=5000 /nix/store/s7awkfc4pym4zj139fsxrjs5xwf5hhnd-nodejs-24.13.0-wrapped/bin/node /home/runner/workspace/artifacts/mobile/server/android-sim.js"

[[workflows.workflow]]
name = "Mobile (Expo Go)"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'export EXPO_NO_DEV_TOOLS=1 && export REACT_NATIVE_DISABLE_DEVTOOLS=1 && export REACT_NATIVE_PACKAGER_HOSTNAME=$(echo $REPLIT_DEV_DOMAIN | sed \"s|https://||\") && pnpm start --host tunnel --port 8080'"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Android Emulator"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd artifacts/mobile && export EXPO_NO_DEV_TOOLS=1 && export REACT_NATIVE_DISABLE_DEVTOOLS=1 && export GRADLE_OPTS=\"-Xmx6g\" && npx expo prebuild --platform android && pnpm dev'"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "EAS Build (Android APK)"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd artifacts/mobile && eas build --platform android --profile development --local'"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/mobile: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/mobile"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter mobile run dev"
cwd = "./artifacts/mobile"
waitForPort = 18115
ensurePreviewReachable = "/status"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "18115"
BASE_PATH = "/"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[ports]]
localPort = 4999
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 18115
externalPort = 3000

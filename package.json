{
  "name": "voice-agents-workspace",
  "private": true,
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck:all": "pnpm -r typecheck",
    "build:all": "pnpm -r build",
    "android": "pnpm --filter mobile android",
    "web": "pnpm --filter mobile web",
    "dev": "pnpm --filter mobile dev",
    "ios": "pnpm --filter mobile ios",
    "start": "pnpm --filter mobile start",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "expo-build-properties": "~55.0.14",
    "expo-dev-client": "~55.0.35",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.9.3"
  },
  "resolutions": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.83.10",
    "react-native-vision-camera": "5.0.11",
    "nitrogen": "0.35.9",
    "react-native-nitro-modules": "0.35.9",
    "react-native-nitro-image": "0.15.0"

  }
}
